{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFHenry"
		},
		"ls_storage_account_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_storage_account'"
		},
		"pl_load_car_models_properties_parameters_make_defaultValue": {
			"type": "string",
			"defaultValue": "Honda"
		},
		"pl_load_car_models_properties_parameters_keyVaultBaseUrl_defaultValue": {
			"type": "string",
			"defaultValue": "https://kvhenry.vault.azure.net"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFHenry_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_storage_account_accountKey": {
						"value": "[parameters('ls_storage_account_accountKey')]"
					},
					"pl_load_car_models_properties_parameters_make_defaultValue": {
						"value": "[parameters('pl_load_car_models_properties_parameters_make_defaultValue')]"
					},
					"pl_load_car_models_properties_parameters_keyVaultBaseUrl_defaultValue": {
						"value": "[parameters('pl_load_car_models_properties_parameters_keyVaultBaseUrl_defaultValue')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}