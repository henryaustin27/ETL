{
	"name": "pl_load_car_models",
	"properties": {
		"activities": [
			{
				"name": "GetApiKey",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": {
						"value": "@concat(pipeline().parameters.keyVaultBaseUrl, '/secrets/apiverve-api-key?api-version=7.5')",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "Copy_CarModels_API_To_SQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "GetApiKey",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": true
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET"
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "truncate table dbo.CarModels",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['Make']"
								},
								"sink": {
									"name": "Make",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['CityMPG']"
								},
								"sink": {
									"name": "CityMPG",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['HighwMPG']"
								},
								"sink": {
									"name": "HighwMPG",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['CombMPG']"
								},
								"sink": {
									"name": "CombMPG",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['CityELEC']"
								},
								"sink": {
									"name": "CityELEC",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['HighwELEC']"
								},
								"sink": {
									"name": "HighwELEC",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['CombELEC']"
								},
								"sink": {
									"name": "CombELEC",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['Cyl']"
								},
								"sink": {
									"name": "Cyl",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['Displace']"
								},
								"sink": {
									"name": "Displace",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "['Drive']"
								},
								"sink": {
									"name": "Drive",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['Fuel']"
								},
								"sink": {
									"name": "Fuel",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['Trans']"
								},
								"sink": {
									"name": "Trans",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['Size']"
								},
								"sink": {
									"name": "Size",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['Year']"
								},
								"sink": {
									"name": "Year",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "['Trim']"
								},
								"sink": {
									"name": "Trim",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['Model']"
								},
								"sink": {
									"name": "Model",
									"type": "String"
								}
							}
						],
						"collectionReference": "$.data.cars"
					}
				},
				"inputs": [
					{
						"referenceName": "ds_apiverve_car",
						"type": "DatasetReference",
						"parameters": {
							"make": {
								"value": "@pipeline().parameters.make",
								"type": "Expression"
							},
							"apikey": {
								"value": "@activity('GetApiKey').output.value",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_car_models",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"make": {
				"type": "string",
				"defaultValue": "Honda"
			},
			"keyVaultBaseUrl": {
				"type": "string",
				"defaultValue": "https://kvhenry.vault.azure.net"
			}
		},
		"annotations": []
	}
}